# Server-only credentials. Copy to .env; never put these in a frontend build.
META_API_KEY=
# MODEL_API_KEY is also accepted if META_API_KEY is unset.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Keep local until a real key passes scripts/verify_meta.py --live.
COMPARER=local
META_TIMEOUT_SECONDS=30
META_MAX_OUTPUT_TOKENS=2048
META_MAX_CALLS_PER_HOUR=50
META_MAX_CALLS_PER_OWNER_PER_HOUR=10
# Reviewer login creates a server session. X-Admin-Token remains supported.
ADMIN_TOKEN=

# Optional local profile ML (separate from screenshot similarity).
ML_ENABLED=true
# ML_MODEL_PATH=outputs/ml/profile_risk_model.json
# Pair text-reuse model trained on synthetic profile pairs, independent of Meta.
# PAIR_ML_MODEL_PATH=outputs/ml/pair_risk_model.json

# Public demo only: signed, per-visitor sandbox; separate from local moderator access.
PUBLIC_DEMO_ENABLED=false
DEMO_SESSION_SECRET=
# DEMO_DATA_ROOT=outputs/sandboxes
# CLAIMS_DB_PATH=outputs/claims.sqlite3
